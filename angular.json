{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "host-app": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss",
          "standalone": false
        },
        "@schematics/angular:directive": {
					"standalone": false
				},
				"@schematics/angular:pipe": {
					"standalone": false
				}
      },
      "root": "projects/host-app",
      "sourceRoot": "projects/host-app/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "ngx-build-plus:browser",
          "options": {
            "outputPath": "dist/host-app",
            "index": "projects/host-app/src/index.html",
            "main": "projects/host-app/src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "projects/host-app/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              "projects/host-app/src/favicon.ico",
              "projects/host-app/src/assets"
            ],
            "styles": [
              "@angular/material/prebuilt-themes/indigo-pink.css",
              "projects/host-app/src/styles/styles.scss"
            ],
            "stylePreprocessorOptions": {
              "includePaths": [
                "projects/host-app/src/styles",
                "projects/mfe-app/src/styles"
              ]
            },
            "scripts": [],
            "extraWebpackConfig": "projects/host-app/webpack.config.js",
            "commonChunk": false
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1mb",
                  "maximumError": "5mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "2kb",
                  "maximumError": "2mb"
                }
              ],
              "outputHashing": "all",
              "extraWebpackConfig": "projects/host-app/webpack.prod.config.js"
            },
            "development": {
              "optimization": false,
							"extractLicenses": false,
							"sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "ngx-build-plus:dev-server",
          "options": {
            "port": 4222,
            "publicHost": "http://localhost:4222",
						"extraWebpackConfig": "projects/host-app/webpack.config.js"
          },
          "configurations": {
            "production": {
              "buildTarget": "host-app:build:production",
              "extraWebpackConfig": "projects/host-app/webpack.prod.config.js"
            },
            "development": {
              "buildTarget": "host-app:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "ngx-build-plus:extract-i18n",
          "options": {
            "buildTarget": "host-app:build",
            "extraWebpackConfig": "projects/host-app/webpack.config.js"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": ["zone.js", "zone.js/testing"],
            "tsConfig": "projects/host-app/tsconfig.spec.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              "projects/host-app/src/favicon.ico",
              "projects/host-app/src/assets"
            ],
            "styles": [
              "@angular/material/prebuilt-themes/indigo-pink.css",
              "projects/host-app/src/styles/styles.scss"
            ],
            "scripts": []
          }
        }
      }
    },
    "mfe-app": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss",
          "standalone": false
        },
        "@schematics/angular:directive": {
					"standalone": false
				},
				"@schematics/angular:pipe": {
					"standalone": false
				}
      },
      "root": "projects/mfe-app",
      "sourceRoot": "projects/mfe-app/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "ngx-build-plus:browser",
          "options": {
            "outputPath": "dist/mfe-app",
            "index": "projects/mfe-app/src/index.html",
            "main": "projects/mfe-app/src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "projects/mfe-app/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              "projects/mfe-app/src/favicon.ico",
              "projects/mfe-app/src/assets"
            ],
            "styles": [
              "@angular/material/prebuilt-themes/indigo-pink.css",
              "projects/mfe-app/src/styles/styles.scss"
            ],
            "scripts": [],
            "extraWebpackConfig": "projects/mfe-app/webpack.config.js",
            "commonChunk": false
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kb",
                  "maximumError": "1mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "2kb",
                  "maximumError": "4kb"
                }
              ],
              "outputHashing": "all",
              "extraWebpackConfig": "projects/mfe-app/webpack.prod.config.js"
            },
            "development": {
              "optimization": false,
							"extractLicenses": false,
							"sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "ngx-build-plus:dev-server",
          "options": {
            "port": 4333,
            "publicHost": "http://localhost:4333",
						"extraWebpackConfig": "projects/mfe-app/webpack.config.js"
          },
          "configurations": {
            "production": {
              "buildTarget": "mfe-app:build:production",
              "extraWebpackConfig": "projects/mfe-app/webpack.prod.config.js"
            },
            "development": {
              "buildTarget": "mfe-app:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "ngx-build-plus:extract-i18n",
          "options": {
            "buildTarget": "mfe-app:build",
            "extraWebpackConfig": "projects/mfe-app/webpack.config.js"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": ["zone.js", "zone.js/testing"],
            "tsConfig": "projects/mfe-app/tsconfig.spec.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              "projects/mfe-app/src/favicon.ico",
              "projects/mfe-app/src/assets"
            ],
            "styles": [
              "@angular/material/prebuilt-themes/indigo-pink.css",
              "projects/mfe-app/src/styles/styles.scss"
            ],
            "scripts": []
          }
        }
      }
    }
  }
}
