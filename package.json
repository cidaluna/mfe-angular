{
  "name": "mfe-angular",
  "version": "0.0.0",
  "engines": {
    "node": "18.20.4"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "start:all": "concurrently \"npm run backend\" \"ng serve start:host\" \"ng serve start:mfe\"",
    "start:host": "ng serve host-app -o",
    "start:mfe": "ng serve mfe-app -o",
    "backend": "json-server --watch ./backend/db.json --port 4000 --host localhost",
    "format:check": "prettier --check \"./projects/host-app/src/app/**/*.{ts,html,scss}\" \"./projects/mfe-app/src/app/**/*.{ts,html,scss}\"",
    "format:fix": "prettier --write \"./projects/host-app/src/app/**/*.{ts,html,scss}\" \"./projects/mfe-app/src/app/**/*.{ts,html,scss}\"",
    "run:all": "node node_modules/@angular-architects/module-federation/src/server/mf-dev-server.js",
    "stylelint:host": "stylelint \"projects/host-app/src/app/**/*.scss\" --config stylelint.config.cjs ",
    "stylelint:mfe": "stylelint \"projects/mfe-app/src/app/**/*.scss\" --config stylelint.config.cjs ",
    "stylelint:fix": "stylelint \"projects/{host-app,mfe-app}/src/app/**/*.{css,scss}\" --fix",
    "lint:host": "eslint \"./projects/host-app/src/app/**/*.ts\" ",
    "lint:mfe": "eslint \"./projects/mfe-app/src/app/**/*.ts\" ",
    "lint:fix": "eslint \"./projects/host-app/src/app/**/*.ts\" \"./projects/mfe-app/src/app/**/*.ts\" --fix"
  },
  "private": true,
  "dependencies": {
    "@angular-architects/module-federation": "^18.0.0",
    "@angular-devkit/core": "^18.0.0",
    "@angular/animations": "^18.0.0",
    "@angular/cdk": "^18.0.0",
    "@angular/common": "^18.0.0",
    "@angular/compiler": "^18.0.0",
    "@angular/core": "^18.0.0",
    "@angular/forms": "^18.0.0",
    "@angular/material": "^18.0.0",
    "@angular/platform-browser": "^18.0.0",
    "@angular/platform-browser-dynamic": "^18.0.0",
    "@angular/router": "^18.0.0",
    "@ng-bootstrap/ng-bootstrap": "^18.0.0",
    "bootstrap": "^5.3.3",
    "bootstrap-icons": "^1.11.3",
    "file-saver": "^2.0.5",
    "rxjs": "~7.8.1",
    "tslib": "^2.6.2",
    "xlsx": "^0.18.5",
    "zone.js": "~0.14.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.0.0",
    "@angular-devkit/schematics": "^18.0.0",
    "@angular-eslint/builder": "^18.0.0",
    "@angular-eslint/eslint-plugin": "^18.0.0",
    "@angular-eslint/eslint-plugin-template": "^18.0.0",
    "@angular-eslint/template-parser": "^18.0.0",
    "@angular/cli": "^18.0.0",
    "@angular/compiler-cli": "^18.0.0",
    "@types/bootstrap": "^5.2.10",
    "@types/file-saver": "^2.0.7",
    "@types/jasmine": "~4.3.0",
    "@types/node": "^18.19.34",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@typescript-eslint/utils": "^6.0.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.29.0",
    "jasmine-core": "~4.5.0",
    "json-server": "^1.0.0-beta.3",
    "karma": "~6.4.2",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.0.0",
    "ngx-build-plus": "^18.0.0",
    "prettier": "^3.5.3",
    "stylelint": "^15.10.0",
    "stylelint-config-prettier": "^9.0.5",
    "stylelint-config-standard-scss": "^10.0.0",
    "stylelint-scss": "^5.0.0",
    "typescript": "~5.5.2"
  }
}
